<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.simple-systems-se.grok-mon-api</id>
  <name>Grok API Monitor</name>
  <summary>Remaining xAI API prepaid credits in the COSMIC panel</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Unlicense</project_license>
  <developer id="io.github.simple-systems-se">
    <name>Simple Systems</name>
  </developer>
  <description>
    <p>
      A panel applet for the COSMIC™ desktop that shows remaining prepaid
      credits for the xAI API, plus a short list of API keys on the team.
    </p>
    <p>
      This unofficial applet reads a Management API key you store locally
      (read-only) and calls xAI’s Management API billing endpoints. It is
      not affiliated with xAI.
    </p>
  </description>
  <launchable type="desktop-id">io.github.simple-systems-se.grok-mon-api.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-grok-monitor</binary>
  </provides>
  <url type="homepage">https://github.com/simple-systems-se/grok-mon</url>
  <url type="bugtracker">https://github.com/simple-systems-se/grok-mon/issues</url>
  <url type="vcs-browser">https://github.com/simple-systems-se/grok-mon</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <releases>
    <release version="0.1.0" date="2026-08-31">
      <description>
        <p>Initial API prepaid remaining-credits applet.</p>
      </description>
    </release>
  </releases>
</component>
