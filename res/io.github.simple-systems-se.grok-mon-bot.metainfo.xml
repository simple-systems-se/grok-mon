<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.simple-systems-se.grok-mon-bot</id>
  <name>Grok Bot Monitor</name>
  <summary>Retired. Remove this applet. Usage is on Grok Monitor.</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Unlicense</project_license>
  <developer id="io.github.simple-systems-se">
    <name>Simple Systems</name>
  </developer>
  <description>
    <p>
      Retired panel slot. Grok Bot usage is included in the shared weekly pool
      on Grok Monitor. Remove this applet from the COSMIC panel after updating.
      It does not poll usage.
    </p>
  </description>
  <launchable type="desktop-id">io.github.simple-systems-se.grok-mon-bot.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-grok-monitor</binary>
  </provides>
  <url type="homepage">https://github.com/simple-systems-se/grok-mon</url>
  <url type="bugtracker">https://github.com/simple-systems-se/grok-mon/issues</url>
  <url type="vcs-browser">https://github.com/simple-systems-se/grok-mon</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <releases>
    <release version="0.4.0" date="2026-11-12">
      <description>
        <p>Still retired. Weekly usage stays on Grok Monitor, one chip per configured account.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-11-06">
      <description>
        <p>Stop polling the separate Grok Bot usage ledger. Remove this applet from the panel.</p>
      </description>
    </release>
    <release version="0.2.4" date="2026-10-01">
      <description>
        <p>Version bump to match the shared applet package.</p>
      </description>
    </release>
    <release version="0.2.3" date="2026-09-22">
      <description>
        <p>Report when weekly credits will run out in the Bot popup.</p>
      </description>
    </release>
    <release version="0.2.2" date="2026-09-19">
      <description>
        <p>Show weekly usage pace (on track / ahead / behind) in the Bot popup.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-09-16">
      <description>
        <p>Replace personal machine examples in docs and tests with generic placeholders.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-16">
      <description>
        <p>Discover signed-in accounts from every Grok Bot* userData directory.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-23">
      <description>
        <p>Initial public release.</p>
      </description>
    </release>
  </releases>
</component>
