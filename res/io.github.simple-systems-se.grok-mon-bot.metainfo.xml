<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.simple-systems-se.grok-mon-bot</id>
  <name>Grok Bot Monitor</name>
  <summary>Grok Bot weekly usage in the COSMIC panel</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Unlicense</project_license>
  <developer id="io.github.simple-systems-se">
    <name>Simple Systems</name>
  </developer>
  <description>
    <p>
      A panel applet for the COSMIC™ desktop that shows current Grok Bot weekly
      usage from the Grok Bot desktop app, plus a short list of live bots.
    </p>
    <p>
      This unofficial applet decrypts the Grok Bot local session (keyring plus
      sand-secrets.json, read-only) and calls Cursor’s private usage endpoints.
      It is not affiliated with Cursor or xAI.
    </p>
  </description>
  <launchable type="desktop-id">io.github.simple-systems-se.grok-mon-bot.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-grok-monitor</binary>
  </provides>
  <url type="homepage">https://github.com/simple-systems-se/grok-mon</url>
  <url type="bugtracker">https://github.com/simple-systems-se/grok-mon/issues</url>
  <url type="vcs-browser">https://github.com/simple-systems-se/grok-mon</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <releases>
    <release version="0.1.0" date="2026-08-23">
      <description>
        <p>Initial public release.</p>
      </description>
    </release>
  </releases>
</component>
