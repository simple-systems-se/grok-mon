<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.simple-systems-se.grok-mon</id>
  <name>Grok Monitor</name>
  <summary>Grok Build credit usage in the COSMIC panel</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Unlicense</project_license>
  <developer id="io.github.simple-systems-se">
    <name>Simple Systems</name>
  </developer>
  <description>
    <p>
      A panel applet for the COSMIC™ desktop that shows current Grok Build
      credit usage, matching the /usage view in the Grok CLI.
    </p>
    <p>
      This unofficial applet reads the Grok CLI session on disk (read-only)
      and calls the Grok CLI billing endpoint. It is not affiliated with xAI.
    </p>
  </description>
  <launchable type="desktop-id">io.github.simple-systems-se.grok-mon.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-grok-monitor</binary>
  </provides>
  <url type="homepage">https://github.com/simple-systems-se/grok-mon</url>
  <url type="bugtracker">https://github.com/simple-systems-se/grok-mon/issues</url>
  <url type="vcs-browser">https://github.com/simple-systems-se/grok-mon</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <releases>
    <release version="0.2.1" date="2026-09-16">
      <description>
        <p>Replace personal machine examples in docs and tests with generic placeholders.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-16">
      <description>
        <p>Grok Bot Monitor reads accounts from every Grok Bot* config directory.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-23">
      <description>
        <p>Initial public release.</p>
      </description>
    </release>
  </releases>
</component>
